{
  "expo": {
    "name": "HN Reader",
    "slug": "hn-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hnreader",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#d9480f" },
    "ios": { "bundleIdentifier": "com.codebyramiz.hnreader", "supportsTablet": true },
    "android": {
      "package": "com.codebyramiz.hnreader",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#d9480f" }
    },
    "plugins": ["expo-router", "expo-web-browser"],
    "experiments": { "typedRoutes": true }
  }
}
