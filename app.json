{
  "expo": {
    "name": "HN Reader",
    "slug": "hn-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hnreader",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.codebyramiz.hnreader",
      "supportsTablet": true
    },
    "android": {
      "package": "com.codebyramiz.hnreader",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#d9480f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#d9480f",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/rn-showcase"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    }
  }
}
